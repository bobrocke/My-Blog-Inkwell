{{ set currentUrl = page?.url ?? listing?.url ?? '/' }}

<nav class="site-nav-wrapper" aria-label="Main navigation">
  <ul class="site-nav" id="site-nav" role="list">
    <li>
      {{ if currentUrl === "/" || currentUrl.startsWith("/page/") }}
        <span class="site-nav__current" aria-current="page">Home</span>
      {{ else }}
        <a href="/">Home</a>
      {{ /if }}
    </li>
    <li>
      {{ if currentUrl === "/categories/" }}
        <span class="site-nav__current" aria-current="page">Categories</span>
      {{ else }}
        <a href="/categories/">Categories</a>
      {{ /if }}
    </li>
    <li>
      {{ if currentUrl === "/tags/" }}
        <span class="site-nav__current" aria-current="page">Tags</span>
      {{ else }}
        <a href="/tags/">Tags</a>
      {{ /if }}
    </li>
    <li>
      {{ if currentUrl.startsWith("/about") }}
        <span class="site-nav__current" aria-current="page">About</span>
      {{ else }}
        <a href="/about/">About</a>
      {{ /if }}
    </li>
  </ul>

  <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
    <svg class="icon icon--sun" aria-hidden="true" width="18" height="18"><use href="#icon-sun"/></svg>
    <svg class="icon icon--moon" aria-hidden="true" width="18" height="18"><use href="#icon-moon"/></svg>
  </button>

  <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation">
    <span class="nav-toggle__bar" aria-hidden="true"></span>
    <span class="nav-toggle__bar" aria-hidden="true"></span>
    <span class="nav-toggle__bar" aria-hidden="true"></span>
  </button>
</nav>
