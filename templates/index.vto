{{ layout "base.vto" }}

<div class="content">
  {{ for post of blog }}
    <div>
      {{ include "partials/post-meta-dates.vto" }}

      <h2 class="blog-title"><a href="{{ post.url }}">{{ post.data.title |> markdownifyInline }}</a></h2>

      {{ include "partials/post-meta-tax.vto" { categories: post.data.categories ?? [], tags: post.data.tags ?? [], page: page } }}

      <div class="prose post-summary">
        {{ post.data.post_excerpt |> markdownify }}
      </div>
    </div>
  {{ /for }}

  {{ include "partials/pagination.vto" { pagination: pagination, page: page } }}

</div>
