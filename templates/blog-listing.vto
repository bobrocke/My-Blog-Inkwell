{{ layout "base.vto" }}

  <div class="wrapper">
    <div class="stack" data-space="2xl">
      <div class="page-hero">
        <p class="page-hero__eyebrow">Not Archive</p>
        <h1 class="page-hero__title">{{ listing.title ?? listing.collection }}</h1>
      </div>

      <div class="grid" data-layout="2-col">
        {{ for p of listing.pages }}
          <article class="post-card">
            {{ if p.frontmatter.date }}
              {{ include "partials/post-meta-dates.vto" { page: p, dateClass: "post-card__date" } }}
            {{ /if }}
            <h2 class="post-card__title">
              <a href="{{ p.url }}">{{ p.frontmatter.title }}</a>
            </h2>
            {{ if p.excerpt }}
              <p class="post-card__excerpt">{{ p.excerpt }}</p>
            {{ /if }}
          </article>
        {{ /for }}
      </div>

      {{ if listing.pagination.prevUrl || listing.pagination.nextUrl }}
        <nav class="pagination" aria-label="Page navigation">
          {{ if listing.pagination.prevUrl }}
            <a href="{{ listing.pagination.prevUrl }}" class="pagination__link">← Newer</a>
          {{ else }}
            <span></span>
          {{ /if }}
          {{ if listing.pagination.nextUrl }}
            <a href="{{ listing.pagination.nextUrl }}" class="pagination__link">Older →</a>
          {{ /if }}
        </nav>
      {{ /if }}
    </div>
  </div>

{{ /layout }}
