{{ layout "base.vto" }}

  <div class="wrapper">
    <div class="stack" data-space="xs">
      <div class="grid" data-layout="2-col">
        {{ for p of listing.pages }}
          <article class="post-card">
            {{ if p.frontmatter.date }}
              {{ include "partials/post-meta-dates.vto" { page: p, dateClass: "post-card__date" } }}
            {{ /if }}
            <h2 class="post-card__title">
              <a href="{{ p.url }}">{{ p.frontmatter.title }}</a>
            </h2>
            {{ include "partials/post-meta-tax.vto" { categories: p.frontmatter.categories ?? [], tags: p.frontmatter.tags ?? [], page: p, listingUrl: listing.url } }}
            {{ if p.excerpt }}
              <p class="post-card__excerpt">{{ p.excerpt }}</p>
            {{ /if }}
          </article>
        {{ /for }}
      </div>

      {{ include "partials/pagination.vto" { pagination: listing.pagination, baseUrl: listing.url } }}
    </div>
  </div>

{{ /layout }}
